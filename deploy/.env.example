# LabVory deployment configuration.
# Copy to .env (same directory) and adjust before first start.

# --- Database (used to provision the PostgreSQL container) ---
LV_DB_USER=labvory
# Use a long random password. The database is never exposed outside the compose network.
LV_DB_PASSWORD=change-me-long-random
LV_DB_NAME=labvory

# --- HTTP ---
# Host port for the web interface. Bound on 0.0.0.0 (all interfaces) so other
# machines on your network can reach it at http://<host-ip>:$LV_HTTP_PORT.
LV_HTTP_PORT=8088
# Host port for direct API access (http://<host-ip>:$LV_API_PORT/api/v1/...).
LV_API_PORT=8080

# --- Secrets ---
# 32-byte hex key (openssl rand -hex 32) used to encrypt integration credentials
# at rest. REQUIRED for Proxmox tokens; without it, secret storage is disabled.
# Generate: openssl rand -hex 32
LV_SECRET_KEY=

# --- Demo seed ---
# Set to "dev" to populate an EMPTY database with a realistic homelab
# (12 assets, 3 subnets, VLANs, allocations, 5 services). Never applied to
# a non-empty inventory, and never shipped enabled by default.
# LV_SEED_MODE=dev
# Set true when LabVory is served over HTTPS (e.g. behind a TLS-terminating reverse proxy).
# Marks session and CSRF cookies Secure.
LV_COOKIE_SECURE=false
